{
    "name": "holoai",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev:b": "pnpm --filter @holoai/backend start",
        "build": "pnpm -r build",
        "start": "pnpm -r build && pm2 start ecosystem.config.cjs --env production",
        "stop": "pm2 stop ecosystem.config.cjs",
        "restart": "pm2 restart ecosystem.config.cjs --env production",
        "logs": "pm2 logs holoai-backend",
        "lint": "eslint .",
        "format": "prettier --write .",
        "m:new": "pnpm --filter @holoai/backend m:new",
        "m:up": "pnpm --filter @holoai/backend m:up",
        "m:down": "pnpm --filter @holoai/backend m:down",
        "m:status": "pnpm --filter @holoai/backend m:status"
    },
    "engines": {
        "node": ">=24.14.0 <25.0.0",
        "pnpm": "^11.0.0"
    },
    "dependencies": {
        "pm2": "^7.0.0"
    },
    "devDependencies": {
        "prettier": "^3.8.1",
        "eslint-config-prettier": "^10.1.5",
        "@tsconfig/node24": "^24.0.3",
        "@eslint/js": "^9.39.4",
        "@types/node": "^24.12.0",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.4",
        "globals": "^17.4.0",
        "jiti": "^2.6.1",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.56.1"
    }
}
