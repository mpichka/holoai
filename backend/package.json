{
    "name": "@holoai/backend",
    "version": "0.0.0",
    "private": true,
    "type": "commonjs",
    "main": "dist/src/main.js",
    "engines": {
        "node": ">=24.14.0 <25.0.0"
    },
    "scripts": {
        "build": "prisma generate && tsc",
