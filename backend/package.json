        "awilix": "13.0.3",
        "dotenv": "17.4.2",
        "express": "5.2.1",
        "luxon": "^3.7.2",
        "node-telegram-bot-api": "2.1.0",
        "pg": "^8.23.1",
        "winston": "3.19.0",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.3",
        "@types/express": "^5.0.6",
        "@types/luxon": "^3.7.6",
        "@types/node": "^24.12.0",
        "prisma": "7.10.1",
        "tsx": "^4.20.0",
        "typescript": "^5.9.0"
    }
